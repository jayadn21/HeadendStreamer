{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/headend-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HeadendStreamer": {
    "ConfigDirectory": "configs",
    "LogDirectory": "logs",
    "FfmpegPath": "C:\\ffmpeg\\bin\\ffmpeg.exe",
    "DefaultMulticastBase": "239.255.255",
    "DefaultPortRange": {
      "Start": 1234,
      "End": 1334
    },
    "AutoRestart": true,
    "HealthCheckInterval": 30,
    "MaxLogFiles": 10,
    "MaxLogSizeMB": 10,
    "Go2rtc": {
      "ExecutablePath": "bin\\Debug\\net8.0\\go2rtc\\go2rtc",
      "WorkingDirectory": "bin\\Debug\\net8.0\\go2rtc"
    },
    "OBS_Scheduler": {
      "ExecutablePath": "C:\\siti-src\\obs_scenescheduler",
      "ExePath": "C:\\siti-src\\obs_scenescheduler\\build\\scenescheduler.exe -headless",
      "ServerURL": "http://localhost:8081"
    },
    "SPX_Graphics": {
      "ExecutablePath": "C:\\siti-src\\spx-gc",
      "ExePath": "node server.js",
      "ServerURL": "http://localhost:5656"
    }
  }
}